{
  "expo": {
    "name": "traduca-app",
    "slug": "traduca-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "traducaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "br.com.traduca.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Traduca",
      "shortName": "Traduca",
      "lang": "pt-BR",
      "description": "App de alunos do Traduca Idiomas: aulas, materiais, atividades e desempenho do curso.",
      "display": "standalone",
      "startUrl": "/",
      "orientation": "portrait",
      "themeColor": "#1B2CC1",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Traduca usa suas fotos para você escolher a foto do seu perfil.",
          "cameraPermission": "O Traduca usa a câmera para você tirar a foto do seu perfil."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Traduca usa o microfone para você gravar a resposta das atividades de áudio."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B2CC1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d617225-8331-4cec-b543-f6bc589d4add"
      }
    }
  }
}
